# === PRODUCTION (Render + Neon) — checklist secrets ===
# Ne PAS committer un fichier .env.prod avec de vraies valeurs.
# Copier ces clés dans le Dashboard Render (Environment) ou au prompt Blueprint.

SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Connection string Neon (console.neon.tech → Connection details)
# Exemple : postgresql://user:pass@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=require

APP_ADMIN_USERNAME=admin
# Min. 12 caractères, pas une valeur d'exemple — hashé BCrypt au démarrage
APP_ADMIN_PASSWORD=RemplacezParUnMotDePasseFort

# Optionnel (déjà dans render.yaml)
# JAVA_OPTS=-Xms256m -Xmx512m
# HIKARI_MAX_POOL_SIZE=5
